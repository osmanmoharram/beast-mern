{
    "name": "beast-mern",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/index.ts",
        "build": "npm run clean && node node_modules/typescript7/bin/tsc",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
        "clean": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/helmet": "^0.0.48",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.9.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/eslint": "^9.6.1",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.3.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.68.0",
        "typescript7": "npm:typescript@^7.0.2"
    }
}
